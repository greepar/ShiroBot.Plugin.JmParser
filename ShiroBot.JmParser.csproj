<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <Version>1.3.1</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <HostPluginDir>..\ShiroBot\bin\Debug\$(TargetFramework)\plugins\$(AssemblyName)\</HostPluginDir>
        <Configurations>Debug;DebugPlugin;DebugAdapter;DebugAll;Release</Configurations>
        <RootNamespace>ShiroBot.JmParser</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Tests/**/*.cs" />
        <InternalsVisibleTo Include="ShiroBot.JmParser.Tests" />
    </ItemGroup>

    <!-- 让 partial class 在 IDE 中折叠到 .axaml 之下，仅影响 Solution Explorer 显示 -->
    <ItemGroup>
        <Compile Update="Views\PreviewCard.axaml.cs">
            <DependentUpon>PreviewCard.axaml</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2">
            <ExcludeAssets>runtime</ExcludeAssets>
            <PrivateAssets>none</PrivateAssets>
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="PDFsharp" Version="6.2.4" />
        <PackageReference Include="ShiroBot.SDK" Version="0.9.8" />

        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Views\DescriptionCard.axaml.cs">
        <DependentUpon>DescriptionCard.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\PreviewCard.axaml.cs">
        <SubType>Code</SubType>
      </Compile>
      <None Update="Assets\**\*">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>
    </ItemGroup>

    <Target Name="RepackPlugin" AfterTargets="Publish" Condition="'$(Configuration)'=='Release'">
        <PropertyGroup>
            <MergedPluginFile>$(PublishDir)$(AssemblyName).merged.dll</MergedPluginFile>
            <MergedPluginPdb>$(PublishDir)$(AssemblyName).merged.pdb</MergedPluginPdb>
            <PublishedPluginFile>$(PublishDir)$(AssemblyName).dll</PublishedPluginFile>
            <PublishedPluginPdb>$(PublishDir)$(AssemblyName).pdb</PublishedPluginPdb>
        </PropertyGroup>

        <Delete Files="$(MergedPluginFile);$(MergedPluginPdb)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PublishedPluginFile)" OverwriteReadOnlyFiles="true" />
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFiles="$(PublishedPluginPdb)" OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />

        <ItemGroup>
            <RepackInput Include="$(PublishedPluginFile)" />
            <RepackDependency Include="$(PublishDir)*.dll"
                              Exclude="$(PublishedPluginFile);
                                       $(MergedPluginFile);
                                       $(PublishDir)Avalonia*.dll;
                                       $(PublishDir)SkiaSharp*.dll;
                                       $(PublishDir)HarfBuzzSharp*.dll;
                                       $(PublishDir)MicroCom*.dll;
                                       $(PublishDir)ShiroBot.SDK.dll;
                                       $(PublishDir)ShiroBot.Model.dll;
                                       $(PublishDir)ShiroBot.Model.QQ.dll;
                                       $(PublishDir)ShiroBot.Model.Discord.dll;
                                       $(PublishDir)ShiroBot.Model.Telegram.dll;
                                       $(PublishDir)System*.dll;
                                       $(PublishDir)mscorlib.dll;
                                       $(PublishDir)netstandard.dll" />
            <RepackInput Include="@(RepackDependency)" />
        </ItemGroup>

        <ILRepack
                TargetKind="Dll"
                OutputFile="$(MergedPluginFile)"
                InputAssemblies="@(RepackInput)"
                LibraryPath="$(PublishDir);$(TargetDir);@(ReferencePath->'%(RootDir)%(Directory)')"
                Internalize="false"
                Parallel="true"
                DebugInfo="true" />

        <Copy SourceFiles="$(MergedPluginFile)" DestinationFiles="$(PublishDir)$(AssemblyName).dll" OverwriteReadOnlyFiles="true" />
        <Copy SourceFiles="$(MergedPluginPdb)" DestinationFiles="$(PublishedPluginPdb)" OverwriteReadOnlyFiles="true" Condition="Exists('$(MergedPluginPdb)')" />
        <Delete Files="$(MergedPluginFile)" />
        <Delete Files="$(MergedPluginPdb)" />
        <Delete Files="@(RepackDependency)" />
        <Delete Files="$(PublishDir)ShiroBot.SDK.dll;$(PublishDir)ShiroBot.SDK.pdb;$(PublishDir)ShiroBot.Model.QQ.dll;$(PublishDir)ShiroBot.Model.QQ.pdb;$(PublishDir)ShiroBot.Model.Discord.dll;$(PublishDir)ShiroBot.Model.Discord.pdb;$(PublishDir)ShiroBot.Model.Telegram.dll;$(PublishDir)ShiroBot.Model.Telegram.pdb" />
        <ItemGroup>
            <HostRenderingAssets Include="$(PublishDir)Avalonia*.dll;$(PublishDir)Avalonia*.pdb;$(PublishDir)SkiaSharp*.dll;$(PublishDir)SkiaSharp*.pdb;$(PublishDir)HarfBuzzSharp*.dll;$(PublishDir)HarfBuzzSharp*.pdb;$(PublishDir)MicroCom*.dll;$(PublishDir)MicroCom*.pdb;$(PublishDir)runtimes/**/*SkiaSharp*;$(PublishDir)runtimes/**/*HarfBuzzSharp*;$(PublishDir)runtimes/**/*AvaloniaNative*" />
        </ItemGroup>
        <Delete Files="@(HostRenderingAssets);$(PublishDir)$(AssemblyName).deps.json" />
    </Target>

    <Target Name="CopyPluginToHost"
            AfterTargets="Build"
            Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='DebugPlugin' or '$(Configuration)'=='DebugAll'">
        <MakeDir Directories="$(HostPluginDir)" />

        <ItemGroup>
            <PluginDebugOutput Include="$(TargetDir)**\*"
                               Exclude="$(TargetDir)ShiroBot.SDK.dll;$(TargetDir)ShiroBot.SDK.pdb;$(TargetDir)ShiroBot.Model.dll;$(TargetDir)ShiroBot.Model.pdb" />
        </ItemGroup>

        <Copy SourceFiles="@(PluginDebugOutput)"
              DestinationFiles="@(PluginDebugOutput->'$(HostPluginDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
